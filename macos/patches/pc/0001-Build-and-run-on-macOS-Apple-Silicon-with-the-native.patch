diff --git a/src/launch_arguments.h b/src/launch_arguments.h
index 7416aa0..4d4436e 100644
--- a/src/launch_arguments.h
+++ b/src/launch_arguments.h
@@ -70,13 +70,26 @@ inline int StartAfterExit(const std::filesystem::path& executable, std::vector<s
   for (auto& value : values) argv.push_back(value.data());
   argv.push_back(nullptr);
   int wait_pipe[2];
+#if defined(__APPLE__)
+  // macOS has no pipe2: the ends are made close-on-exec before the fork.
+  if (pipe(wait_pipe) != 0) return -1;
+  fcntl(wait_pipe[0], F_SETFD, FD_CLOEXEC);
+  fcntl(wait_pipe[1], F_SETFD, FD_CLOEXEC);
+#else
   if (pipe2(wait_pipe, O_CLOEXEC) != 0) return -1;
+#endif
   const pid_t child = fork();
   if (child == 0) {
     // Only async-signal-safe calls until execv. The other descriptors this
     // process holds (logs, devices) close at the exec instead of leaking.
     close(wait_pipe[1]);
+#if defined(__APPLE__)
+    // No close_range on macOS: each descriptor is marked one by one (fcntl is
+    // async-signal-safe).
+    for (int fd = 3, last = getdtablesize(); fd < last; ++fd) fcntl(fd, F_SETFD, FD_CLOEXEC);
+#else
     close_range(3, ~0U, CLOSE_RANGE_CLOEXEC);
+#endif
     char byte;
     while (read(wait_pipe[0], &byte, 1) < 0 && errno == EINTR) {}
     execv(argv[0], argv.data());
diff --git a/tools/native-renderer/plume-engine.cmake b/tools/native-renderer/plume-engine.cmake
index 9c3d991..a7be80b 100644
--- a/tools/native-renderer/plume-engine.cmake
+++ b/tools/native-renderer/plume-engine.cmake
@@ -142,4 +142,12 @@ if(BROKENBOND_NATIVE_VULKAN)
         find_package(X11 REQUIRED)
         target_link_libraries(native_renderer_plume_vulkan PUBLIC X11::X11)
     endif()
+    # On macOS the Vulkan backend runs on MoltenVK: Plume's Cocoa and Metal part
+    # (plume_apple.mm) is Objective-C++.
+    if(APPLE)
+        enable_language(OBJCXX)
+        target_sources(native_renderer_plume_vulkan PRIVATE "${NATIVE_RENDERER_PLUME_SOURCE}/plume_apple.mm")
+        target_link_libraries(native_renderer_plume_vulkan PUBLIC "-framework Cocoa" "-framework QuartzCore"
+                              "-framework Metal")
+    endif()
 endif()
diff --git a/tools/native-renderer/shader-cache.cmake b/tools/native-renderer/shader-cache.cmake
index 1264366..8858484 100644
--- a/tools/native-renderer/shader-cache.cmake
+++ b/tools/native-renderer/shader-cache.cmake
@@ -31,8 +31,8 @@
 # on Linux, or the one supplied through BROKENBOND_SPIRV_VAL).
 #
 # BROKENBOND_DXC is the DXC of the build host from dxc-bin (dxc.exe on Windows, dxc-linux on
-# Linux), and BROKENBOND_DXC_ENV the command prefix that runs it and every tool that starts
-# it: dxc-linux finds libdxcompiler.so through LD_LIBRARY_PATH.
+# Linux, dxc-macos on macOS), and BROKENBOND_DXC_ENV the command prefix that runs it and every
+# tool that starts it: dxc-linux finds libdxcompiler.so through LD_LIBRARY_PATH.
 include_guard(GLOBAL)
 include(ExternalProject)
 enable_language(C)  # Zstandard.
@@ -48,6 +48,15 @@ if(CMAKE_HOST_WIN32)
 elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
   set(BROKENBOND_DXC "${_brokenbond_dxc_bin}/bin/x64/dxc-linux")
   set(BROKENBOND_DXC_ENV "${CMAKE_COMMAND}" -E env "LD_LIBRARY_PATH=${_brokenbond_dxc_bin}/lib/x64")
+elseif(CMAKE_HOST_APPLE)
+  # dxc-macos looks for libdxcompiler.dylib in ../lib (its rpath), and dxc-bin keeps
+  # it in lib/arm64. A copy with that layout in the build folder needs no
+  # DYLD_LIBRARY_PATH, which macOS drops when it starts a protected binary (python3).
+  set(_brokenbond_dxc_copy "${CMAKE_BINARY_DIR}/dxc-macos")
+  file(COPY "${_brokenbond_dxc_bin}/bin/arm64/dxc-macos" DESTINATION "${_brokenbond_dxc_copy}/bin")
+  file(COPY "${_brokenbond_dxc_bin}/lib/arm64/" DESTINATION "${_brokenbond_dxc_copy}/lib")
+  set(BROKENBOND_DXC "${_brokenbond_dxc_copy}/bin/dxc-macos")
+  set(BROKENBOND_DXC_ENV)
 else()
   message(FATAL_ERROR "The shader cache of the native renderer has no DXC for ${CMAKE_HOST_SYSTEM_NAME}")
 endif()
@@ -121,6 +130,8 @@ function(brokenbond_shader_cache target source)
   # executable still translates them. Its DXIL (the in-process cache mode, not the
   # single-file mode the chain uses) needs dxil.dll, which dxc-bin has on Windows only.
   string(REGEX REPLACE "clang\\+\\+" "clang" c_compiler "${CMAKE_CXX_COMPILER}")
+  # On macOS the compiler is /usr/bin/c++, whose C side is /usr/bin/cc.
+  string(REGEX REPLACE "c\\+\\+$" "cc" c_compiler "${c_compiler}")
   if(CMAKE_HOST_WIN32)
     set(recomp_dxil ON)
   else()
