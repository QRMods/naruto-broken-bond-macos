 void SetThreadPriority(ThreadPriority priority) {
+#if defined(__APPLE__)
+  // macOS schedules by quality of service: utility work runs on the efficiency
+  // cores first, the default class beside the threads that publish the frames.
+  pthread_set_qos_class_self_np(priority == ThreadPriority::kLowest ? QOS_CLASS_UTILITY : QOS_CLASS_DEFAULT, 0);
+#else
   // Switching between these two needs no privilege; nice values stay as they are.
   const sched_param param{};
   pthread_setschedparam(pthread_self(), priority == ThreadPriority::kLowest ? SCHED_BATCH : SCHED_OTHER, &param);
+#endif
 }
 bool ThreadTimes(void* native_thread, uint64_t& kernel_100ns, uint64_t& user_100ns) {
   // A pthread_t is valid until the SDK joins the thread, at the first wait
   // on an ended one: the caller asks only while the thread runs.
   if (!native_thread) return false;
+#if defined(__APPLE__)
+  // The Mach thread of the pthread gives its user and system times apart.
+  thread_basic_info_data_t info{};
+  mach_msg_type_number_t count = THREAD_BASIC_INFO_COUNT;
+  const mach_port_t thread = pthread_mach_thread_np(reinterpret_cast<pthread_t>(native_thread));
+  if (thread == MACH_PORT_NULL ||
+      thread_info(thread, THREAD_BASIC_INFO, reinterpret_cast<thread_info_t>(&info), &count) != KERN_SUCCESS)
+    return false;
+  auto to_100ns = [](const time_value_t& t) { return uint64_t(t.seconds) * 10000000 + uint64_t(t.microseconds) * 10; };
+  kernel_100ns = to_100ns(info.system_time);
+  user_100ns = to_100ns(info.user_time);
+  return true;
+#else
   clockid_t clock{};
   timespec used{};
   if (pthread_getcpuclockid(reinterpret_cast<pthread_t>(native_thread), &clock) != 0 ||
@@ -54,6 +102,7 @@ bool ThreadTimes(void* native_thread, uint64_t& kernel_100ns, uint64_t& user_100
   kernel_100ns = 0;
   user_100ns = uint64_t(used.tv_sec) * 10000000 + uint64_t(used.tv_nsec) / 100;
   return true;
+#endif
 }
 
