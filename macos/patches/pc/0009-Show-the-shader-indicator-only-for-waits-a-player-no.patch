From e506b481f8a0893a32a9af52706fa7fdff9b481a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Agust=C3=ADn=20Lantero=20Barreda?= <agusem@hotmail.com>
Date: Sat, 14 Nov 2026 19:21:56 +0100
Subject: [PATCH 09/10] Show the shader indicator only for waits a player
 notices

The "Compiling shaders" indicator came up whenever any pipeline was being
created and stayed 750 ms after it. On a first run that meant every few
seconds in fights, for pipelines that finish in milliseconds and never
hold the game up. It now shows only once compilation has gone on, with
no pause longer than 150 ms, for a second and a half, as on a cold load,
and still hides 750 ms after the last job.

The startup batch (StartPipelinePrecompile) never shows it: it compiles
the known pipelines in the background while the menus run at full rate,
2.4 s on the first run after an update.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/gpu/common/shader_activity.h | 24 +++++++++++++++++++++++-
 1 file changed, 23 insertions(+), 1 deletion(-)

diff --git a/src/gpu/common/shader_activity.h b/src/gpu/common/shader_activity.h
index d014e9c..954d4d2 100644
--- a/src/gpu/common/shader_activity.h
+++ b/src/gpu/common/shader_activity.h
@@ -26,8 +26,30 @@ struct ShaderCompilation {
   ShaderCompilation() { shader_jobs.fetch_add(1, std::memory_order_relaxed); }
   ~ShaderCompilation() { NoteShaderCompiled(); shader_jobs.fetch_sub(1, std::memory_order_relaxed); }
 };
+// The indicator is for waits a player notices: compilation that keeps going
+// without a real pause for a second and a half, like a cold load. A pipeline
+// created now and then during a fight finishes in milliseconds and stays
+// silent. So does the startup batch (StartPipelinePrecompile): it compiles the
+// known pipelines in the background while the menus run at full rate (2.4 s on
+// the first run after an update, about 0.4 s after). Once shown, it hides
+// 750 ms after the last job ends. Only the UI thread calls this, once per menu
+// frame.
 inline bool ShaderCompilationVisible() {
+  constexpr int64_t kBurstGapMs = 150, kShowAfterMs = 1500, kHideAfterMs = 750;
+  static int64_t busy_since = 0;
+  static bool shown = false;
+  if (shader_batch_running.load(std::memory_order_relaxed)) {
+    busy_since = 0;
+    shown = false;
+    return false;
+  }
+  const auto now = ShaderClock();
   const auto last = shader_last_finished.load(std::memory_order_relaxed);
-  return shader_jobs.load(std::memory_order_relaxed) != 0 || (last != 0 && ShaderClock() - last < 750);
+  const int64_t idle = shader_jobs.load(std::memory_order_relaxed) != 0 ? 0 : last != 0 ? now - last : INT64_MAX;
+  if (idle > kBurstGapMs) busy_since = 0;
+  else if (busy_since == 0) busy_since = now;
+  if (busy_since != 0 && now - busy_since >= kShowAfterMs) shown = true;
+  else if (idle >= kHideAfterMs) shown = false;
+  return shown;
 }
 }  // namespace gpu
